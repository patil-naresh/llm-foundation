# Copy to .env locally; never commit real credentials.
PROVIDER_API_KEY=
PROVIDER_BASE_URL=https://api.openai.com/v1
ALLOWED_MODELS=gpt-4o-mini,gpt-4o
OPENAI_MODEL=gpt-4o-mini
MODEL_PROVIDER_MAP={}
# Example multi-provider setup:
# MODEL_PROVIDER_MAP={"gpt-4o-mini":"OPENAI","meta/llama-3.1-70b-instruct":"NVIDIA"}
# OPENAI_API_KEY=
# OPENAI_BASE_URL=https://api.openai.com/v1
# NVIDIA_API_KEY=
# NVIDIA_BASE_URL=https://integrate.api.nvidia.com/v1
SYSTEM_INSTRUCTIONS=You are a helpful assistant. Answer clearly and accurately.
CORS_ORIGINS=http://localhost:8080
HOST=127.0.0.1
PORT=8000
CONNECT_TIMEOUT_SECONDS=10
READ_TIMEOUT_SECONDS=300
MAX_REQUEST_BYTES=1048576
MAX_QUERY_LENGTH=12000